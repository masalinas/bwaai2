# ==============================================================================
# Async PDF Processing Application - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Provide your API keys below (or leave empty; pypdf and basic features work without them).
# 3. Launch stack: docker compose up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External AI / LLM Services (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
# Enables Gemini 3.8 Flash multimodal parsing and AI executive summarization.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONCURRENCY=2
GEMINI_TIMEOUT_SECONDS=60
SUMMARY_MAX_INPUT_CHARS=100000

# Mistral AI API Key (Get key at: https://console.mistral.ai/)
# Enables Mistral OCR markdown extraction.
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CONCURRENCY=2
MISTRAL_TIMEOUT_SECONDS=60
MISTRAL_INLINE_THRESHOLD_BYTES=10485760

# ------------------------------------------------------------------------------
# 2. Host Port Bindings
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
API_PORT=8000
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. API & Server Tuning
# ------------------------------------------------------------------------------
# Number of Uvicorn worker processes in the API container
API_WORKERS=2
DEBUG=false

# ------------------------------------------------------------------------------
# 4. Storage & Processing Limits (Contracts Aligned)
# ------------------------------------------------------------------------------
# Maximum file size per uploaded PDF (25 MB = 26,214,400 bytes)
MAX_FILE_SIZE_BYTES=26214400

# Maximum number of files in a single batch upload request
MAX_FILES_PER_REQUEST=10

# Temporary binary retention in Redis (24 hours = 86,400 seconds)
PDF_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. Background Worker Tuning
# ------------------------------------------------------------------------------
# Max concurrent jobs processed per worker container instance
WORKER_CONCURRENCY=5

# Minimum idle time (ms) before an unacknowledged job is claimed by XAUTOCLAIM
CLAIM_IDLE_MS=60000

# Maximum retry attempts for transient worker failures before routing to Dead Letter Queue
MAX_ATTEMPTS=3
